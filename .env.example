# =================================================================
# ITBIS - Insider Threat Behavioral Intelligence System
# Production & Local Environment Configuration
# =================================================================

# --- Docker Compose Stack Configuration ---
POSTGRES_DB=itbis_db
POSTGRES_USER=itbis_user
POSTGRES_PASSWORD=ItbisSecurePassword2026!
MONGODB_DB_NAME=itbis_telemetry

# --- Backend Service Configuration ---
# Docker Compose default uses PostgreSQL service:
DATABASE_URL=postgresql+psycopg2://itbis_user:ItbisSecurePassword2026!@postgres:5432/itbis_db
# For lightweight local SQLite mode, uncomment below:
# DATABASE_URL=sqlite:///./itbis.db

MONGODB_URL=mongodb://mongodb:27017
# For local development MongoDB without Docker:
# MONGODB_URL=mongodb://localhost:27017

JWT_SECRET=itbis-enterprise-production-secret-key-2026
JWT_ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Service Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
