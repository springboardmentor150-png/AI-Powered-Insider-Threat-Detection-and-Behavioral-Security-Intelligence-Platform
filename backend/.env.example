# ITBIS Backend Environment Configuration Example
# SQLite mode (default for local development):
DATABASE_URL=sqlite:///./itbis.db
# PostgreSQL mode (used by Docker Compose):
# DATABASE_URL=postgresql+psycopg2://itbis_user:ItbisSecurePassword2026!@localhost:5432/itbis_db

MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=itbis_telemetry
JWT_SECRET=itbis-development-secret-key
JWT_ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
